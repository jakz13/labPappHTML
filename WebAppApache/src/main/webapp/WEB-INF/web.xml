<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>WebAppApache</display-name>

    <!-- Servlets -->
    <servlet>
        <servlet-name>VerificarEmailServlet</servlet-name>
        <servlet-class>com.example.WebAppApache.servlets.VerificarEmailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VerificarEmailServlet</servlet-name>
        <url-pattern>/verificarEmail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AltaUsuarioServlet</servlet-name>
        <servlet-class>com.example.WebAppApache.servlets.AltaUsuarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AltaUsuarioServlet</servlet-name>
        <url-pattern>/altaUsuario</url-pattern>
    </servlet-mapping>

    <!-- Página de bienvenida -->
    <welcome-file-list>
        <welcome-file>PaginaPrincipal.jsp</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>